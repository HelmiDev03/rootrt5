# Partie 4.2 - Strategie Recreate : le YAML est modifie (strategy.type: Recreate)
$ diff deployment.yaml deployment-recreate.yaml
0a1,2
> # Partie 4.2 : meme Deployment que deployment.yaml, avec la strategie Recreate
> # (tous les anciens pods sont supprimes AVANT la creation des nouveaux)
8a11,12
>   strategy:
>     type: Recreate
22d25
<         # Le pod ne recoit du trafic (endpoint du Service) que lorsque httpd accepte les connexions

$ kubectl run availability-probe --image=curlimages/curl --restart=Never --command -- sh -c 'i=0; while true; do i=$((i+1)); c=$(curl -s -o /dev/null -m 1 -w "%{http_code}" http://web-app); echo "$(date +%T) #$i $c"; sleep 0.1; done'
pod/availability-probe created

$ kubectl apply -f deployment-recreate.yaml
deployment.apps/web-app configured

$ kubectl annotate deployment/web-app kubernetes.io/change-cause="v3 : httpd:2.4, strategie Recreate (deployment-recreate.yaml)" --overwrite
deployment.apps/web-app annotated

