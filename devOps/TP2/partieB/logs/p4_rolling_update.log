# Partie 4.1 - Rolling Update (strategie par defaut)
$ kubectl annotate deployment/web-app kubernetes.io/change-cause="v1 : httpd:2.4 (deployment.yaml)"
deployment.apps/web-app annotated

$ kubectl get deployment web-app -o jsonpath="{.spec.strategy}"; echo
{"rollingUpdate":{"maxSurge":"25%","maxUnavailable":"25%"},"type":"RollingUpdate"}

# Sonde de disponibilite : un pod interroge le Service toutes les ~0,1 s pendant toute la mise a jour
$ kubectl run availability-probe --image=curlimages/curl --restart=Never --command -- sh -c 'i=0; while true; do i=$((i+1)); c=$(curl -s -o /dev/null -m 1 -w "%{http_code}" http://web-app); echo "$(date +%T) #$i $c"; sleep 0.1; done'
pod/availability-probe created

$ kubectl set image deployment/web-app httpd=httpd:latest
deployment.apps/web-app image updated

$ kubectl annotate deployment/web-app kubernetes.io/change-cause="v2 : httpd:latest (kubectl set image)" --overwrite
deployment.apps/web-app annotated

$ kubectl rollout status deployment/web-app
Waiting for deployment "web-app" rollout to finish: 1 out of 3 new replicas have been updated...
Waiting for deployment "web-app" rollout to finish: 1 out of 3 new replicas have been updated...
