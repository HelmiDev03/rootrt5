$ kind version
kind v0.33.0 go1.26.7 windows/amd64

$ kubectl version --client
Client Version: v1.37.1
Kustomize Version: v5.8.1

# Creation du cluster multi-noeuds (1 control-plane + 2 workers)
$ cat kind-config.yaml
# Cluster kind du TP : 1 control-plane + 2 workers (configuration demandee par l'enonce)
# Ajouts anticipes pour la Partie 5 et le NodePort (les mappings de ports ne peuvent
# pas etre ajoutes apres la creation du cluster) :
#  - extraPortMappings : ports 80/443 (Ingress) et 30080 (NodePort) publies sur localhost
#  - label ingress-ready=true : le controleur Ingress sera place sur ce noeud
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
- role: control-plane
  labels:
    ingress-ready: "true"
  extraPortMappings:
  - containerPort: 80
    hostPort: 80
    protocol: TCP
  - containerPort: 443
    hostPort: 443
    protocol: TCP
  - containerPort: 30080
    hostPort: 30080
    protocol: TCP
- role: worker
- role: worker

$ kind create cluster --name devops-tp --config kind-config.yaml
