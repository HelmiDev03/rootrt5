# Cause : ce manifeste ne contraint plus le pod au noeud etiquete ingress-ready=true (cf. kind-config.yaml).
# Correctif : ajout du nodeSelector ingress-ready=true -> le pod est replanifie sur devops-tp-control-plane
$ kubectl patch deployment ingress-nginx-controller -n ingress-nginx -p '{"spec":{"template":{"spec":{"nodeSelector":{"ingress-ready":"true","kubernetes.io/os":"linux"}}}}}'
