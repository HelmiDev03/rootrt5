# Le mecanisme : kube-proxy (mode iptables) programme une regle par endpoint, choisie au hasard (module statistic)
$ docker exec devops-tp-worker sh -c 'iptables-save -t nat | grep -E "^-A KUBE-SVC-.*default/web-app -> "'
-A KUBE-SVC-CFS55DGLRWS45HHO -m comment --comment "default/web-app -> 10.244.1.2:80" -m statistic --mode random --probability 0.33333333349 -j KUBE-SEP-5P2NZUJEV4U53UXX
-A KUBE-SVC-CFS55DGLRWS45HHO -m comment --comment "default/web-app -> 10.244.1.3:80" -m statistic --mode random --probability 0.50000000000 -j KUBE-SEP-AEJ6AR55THS6GEVH
-A KUBE-SVC-CFS55DGLRWS45HHO -m comment --comment "default/web-app -> 10.244.2.4:80" -j KUBE-SEP-K6AEOL2BQDMMKDLA

# Chaine complete : KUBE-SERVICES (IP du Service) -> KUBE-SVC (tirage aleatoire) -> KUBE-SEP (DNAT vers l'IP du pod)
$ docker exec devops-tp-worker sh -c 'iptables-save -t nat | grep -E "^-A KUBE-SERVICES .*default/web-app|DNAT.*default/web-app"'
-A KUBE-SERVICES -d 10.96.230.49/32 -p tcp -m comment --comment "default/web-app cluster IP" -m tcp --dport 80 -j KUBE-SVC-CFS55DGLRWS45HHO
-A KUBE-SERVICES -d 172.19.255.200/32 -p tcp -m comment --comment "default/web-app loadbalancer IP" -m tcp --dport 80 -j KUBE-EXT-CFS55DGLRWS45HHO

$ docker exec devops-tp-worker sh -c 'iptables-save -t nat | grep -E "default/web-app.*-j DNAT"'
-A KUBE-SEP-5P2NZUJEV4U53UXX -p tcp -m comment --comment "default/web-app" -m tcp -j DNAT --to-destination 10.244.1.2:80
-A KUBE-SEP-AEJ6AR55THS6GEVH -p tcp -m comment --comment "default/web-app" -m tcp -j DNAT --to-destination 10.244.1.3:80
-A KUBE-SEP-K6AEOL2BQDMMKDLA -p tcp -m comment --comment "default/web-app" -m tcp -j DNAT --to-destination 10.244.2.4:80

