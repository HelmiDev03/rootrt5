# Exercice pratique - Equilibrage de charge
# Terminal 1 (observation) : logs de tous les pods web-app en temps reel (--prefix indique le pod, --tail=0 ignore l'historique)
# Terminal 2 (simulation de trafic) : 60 requetes vers le Service depuis le pod test-pod
$ kubectl exec test-pod -- sh -c 'for i in $(seq 1 60); do curl -s -o /dev/null "http://web-app/?requete=$i"; done; echo "60 requetes envoyees"'
