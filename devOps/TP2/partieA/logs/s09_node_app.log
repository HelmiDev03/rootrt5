# Section 9.2 - Dockerisation de l'application Node.js
$ cat Dockerfile
FROM node:24-alpine
WORKDIR /app
EXPOSE 3000
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . ./
CMD ["node", "index.mjs"]

