# Section 9.6 - Service NodePort
$ kubectl delete svc k8s-web-hello
service "k8s-web-hello" deleted from default namespace

$ kubectl expose deployment k8s-web-hello --type=NodePort --port=3000
service/k8s-web-hello exposed

$ kubectl get svc k8s-web-hello
NAME            TYPE       CLUSTER-IP       EXTERNAL-IP   PORT(S)          AGE
k8s-web-hello   NodePort   10.100.113.228   <none>        3000:32661/TCP   0s

$ minikube ssh -- 'curl -s 192.168.49.2:32661; echo'


# Reponse vide : commande lancee 0 s apres la creation du Service, avant que kube-proxy n'ait
# programme ses regles iptables. Le re-test (fin de la section 9.7) repond correctement.

# Acces depuis Windows : avec le driver docker, minikube service ouvre un tunnel (le terminal doit rester ouvert)
$ minikube service k8s-web-hello --url
http://127.0.0.1:19886
! Because you are using a Docker driver on windows, the terminal needs to be open to run it.

$ for i in 1 2 3 4; do curl -s http://127.0.0.1:19886; echo; done
Hello from the k8s-web-hello-5c89d9df66-fnn7x
Hello from the k8s-web-hello-5c89d9df66-x5rvq
Hello from the k8s-web-hello-5c89d9df66-sw9vh
Hello from the k8s-web-hello-5c89d9df66-sw9vh

# Section 9.7 - Service LoadBalancer
$ kubectl delete svc k8s-web-hello
service "k8s-web-hello" deleted from default namespace

$ kubectl expose deployment k8s-web-hello --type=LoadBalancer --port=3000
service/k8s-web-hello exposed

$ kubectl get svc k8s-web-hello
NAME            TYPE           CLUSTER-IP   EXTERNAL-IP   PORT(S)          AGE
k8s-web-hello   LoadBalancer   10.111.0.3   <pending>     3000:31233/TCP   0s

# EXTERNAL-IP reste <pending> : pas de load balancer cloud. On lance minikube tunnel (en arriere-plan) :
$ kubectl get svc k8s-web-hello
NAME            TYPE           CLUSTER-IP   EXTERNAL-IP   PORT(S)          AGE
k8s-web-hello   LoadBalancer   10.111.0.3   127.0.0.1     3000:31233/TCP   16s

$ for i in 1 2 3 4; do curl -s http://127.0.0.1:3000; echo; done
Hello from the k8s-web-hello-5c89d9df66-mnb2f
Hello from the k8s-web-hello-5c89d9df66-fnn7x
Hello from the k8s-web-hello-5c89d9df66-mnb2f
Hello from the k8s-web-hello-5c89d9df66-fnn7x

