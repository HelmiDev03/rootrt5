# Le Pod n'est PAS joignable depuis la machine hote (reseau interne au cluster) :
$ curl -s -m 5 http://10.244.0.3 || echo 'echec : IP du pod non routable depuis Windows'
echec : IP du pod non routable depuis Windows

# Section 5.3 - Alias pour kubectl
$ alias k=kubectl

$ k get pods
NAME    READY   STATUS    RESTARTS   AGE
nginx   1/1     Running   0          21s

$ k delete pod nginx
pod "nginx" deleted from default namespace

$ k get pods
No resources found in default namespace.

