# Depannage : les pods k8s-web-to-nginx sont en ImagePullBackOff (l'image nginx publique, elle, a ete tiree)
$ kubectl describe pod k8s-web-to-nginx-66d6567d4b-7pbjs | sed -n '/^Events:/,$p'
Events:
  Type     Reason     Age                   From               Message
  ----     ------     ----                  ----               -------
  Normal   Scheduled  4m28s                 default-scheduler  Successfully assigned default/k8s-web-to-nginx-66d6567d4b-7pbjs to minikube
  Normal   Pulling    92s (x5 over 4m28s)   kubelet            spec.containers{k8s-web-to-nginx}: Pulling image "host.minikube.internal:5000/k8s-web-to-nginx:1.0.0"
  Warning  Failed     92s (x5 over 4m28s)   kubelet            spec.containers{k8s-web-to-nginx}: Failed to pull image "host.minikube.internal:5000/k8s-web-to-nginx:1.0.0": unable to pull image: initializing source docker://host.minikube.internal:5000/k8s-web-to-nginx:1.0.0: pinging container registry host.minikube.internal:5000: Get "https://host.minikube.internal:5000/v2/": http: server gave HTTP response to HTTPS client
  Warning  Failed     92s (x5 over 4m28s)   kubelet            spec.containers{k8s-web-to-nginx}: Error: ErrImagePull
  Warning  Failed     24s (x15 over 4m27s)  kubelet            spec.containers{k8s-web-to-nginx}: Error: ImagePullBackOff
  Normal   BackOff    1s (x17 over 4m27s)   kubelet            spec.containers{k8s-web-to-nginx}: Back-off pulling image "host.minikube.internal:5000/k8s-web-to-nginx:1.0.0"

# Cause : CRI-O contacte le registre en HTTPS alors qu'il ecoute en HTTP. Le flag --insecure-registry ecrit par minikube
# dans /etc/sysconfig/crio.minikube n'est pas transmis au service crio (lance sans argument) :
$ minikube ssh -- "cat /etc/sysconfig/crio.minikube; ps -eo args | grep -E \"^/usr/bin/crio\"; systemctl cat crio | grep -E \"^(ExecStart|EnvironmentFile)\""

CRIO_MINIKUBE_OPTIONS='--insecure-registry 10.96.0.0/12 --insecure-registry host.minikube.internal:5000 '
/usr/bin/crio
EnvironmentFile=-/etc/default/crio
ExecStart=/usr/bin/crio \

# Correctif : declarer le registre comme non-securise dans la configuration native de CRI-O, puis redemarrer CRI-O
$ minikube ssh -- "printf '[[registry]]\nlocation = \"host.minikube.internal:5000\"\ninsecure = true\n' | sudo tee /etc/containers/registries.conf.d/50-local-registry.conf"
[[registry]]
location = "host.minikube.internal:5000"
insecure = true

$ minikube ssh -- "sudo systemctl restart crio && systemctl is-active crio"
active

