# Section 12.4 - Application du fichier service.yaml (LoadBalancer, port 3030 -> 3000)
$ cat service.yaml
apiVersion: v1
kind: Service
metadata:
  name: k8s-web-hello
spec:
  type: LoadBalancer
  selector:
    app: k8s-web-hello
  ports:
  - port: 3030
    targetPort: 3000

$ kubectl apply -f service.yaml
service/k8s-web-hello created

$ kubectl get svc
NAME            TYPE           CLUSTER-IP     EXTERNAL-IP   PORT(S)          AGE
k8s-web-hello   LoadBalancer   10.96.103.26   <pending>     3030:32368/TCP   0s
kubernetes      ClusterIP      10.96.0.1      <none>        443/TCP          8m28s

$ kubectl get svc k8s-web-hello
NAME            TYPE           CLUSTER-IP     EXTERNAL-IP   PORT(S)          AGE
k8s-web-hello   LoadBalancer   10.96.103.26   127.0.0.1     3030:32368/TCP   15s

