# Section 14.1 - Verification de la connectivite entre les deux Deployments
$ minikube service k8s-web-to-nginx --url
http://127.0.0.1:64657
! Because you are using a Docker driver on windows, the terminal needs to be open to run it.

$ for i in 1 2 3; do curl -s http://127.0.0.1:64657/; echo; done
Hello from the k8s-web-to-nginx-66d6567d4b-7p9xr
Hello from the k8s-web-to-nginx-66d6567d4b-7p9xr
Hello from the k8s-web-to-nginx-66d6567d4b-2cmtp

$ curl -s http://127.0.0.1:64657/nginx | head -16
