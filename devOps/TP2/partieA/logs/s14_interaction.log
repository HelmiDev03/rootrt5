# Section 14.2 - Resolution du nom du Service en adresse IP (DNS interne CoreDNS)
$ kubectl exec k8s-web-to-nginx-66d6567d4b-2cmtp -- nslookup nginx
Server:		10.96.0.10
Address:	10.96.0.10:53


** server can't find nginx.cluster.local: NXDOMAIN

** server can't find nginx.svc.cluster.local: NXDOMAIN

Name:	nginx.default.svc.cluster.local
Address: 10.109.49.54

** server can't find nginx.cluster.local: NXDOMAIN

** server can't find nginx.svc.cluster.local: NXDOMAIN

command terminated with exit code 1

$ kubectl get svc nginx
NAME    TYPE        CLUSTER-IP     EXTERNAL-IP   PORT(S)   AGE
nginx   ClusterIP   10.109.49.54   <none>        80/TCP    32s

$ kubectl exec k8s-web-to-nginx-66d6567d4b-2cmtp -- cat /etc/resolv.conf
nameserver 10.96.0.10
search default.svc.cluster.local svc.cluster.local cluster.local
options ndots:5

$ kubectl exec k8s-web-to-nginx-66d6567d4b-2cmtp -- wget -qO- http://nginx.default.svc.cluster.local | grep -i '<title>'
<title>Welcome to nginx!</title>

$ kubectl get svc -n kube-system kube-dns
NAME       TYPE        CLUSTER-IP   EXTERNAL-IP   PORT(S)                  AGE
kube-dns   ClusterIP   10.96.0.10   <none>        53/UDP,53/TCP,9153/TCP   9m57s

# Section 14.3 - Suppression des deux applications
$ kubectl delete -f nginx.yaml -f k8s-web-to-nginx.yaml
